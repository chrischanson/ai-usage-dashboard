# AI Usage Dashboard systemd service
# Install via: sudo bash install/install.sh /absolute/path/to/project
# Or manually: edit PROJECT_DIR and USER below, then:
#   sudo cp install/usage-dashboard.service /etc/systemd/system/usage-dashboard.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now usage-dashboard

[Unit]
Description=AI Usage Dashboard
Documentation=https://github.com/anomalyco/opencode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/usage-dashboard
ExecStart=PROJECT_DIR/venv/bin/python3 -m main
WorkingDirectory=PROJECT_DIR/backend
Restart=on-failure
RestartSec=5
User=PROJECT_USER
Group=PROJECT_USER
StandardOutput=journal
StandardError=journal

# Hardening: the process holds live AI provider tokens in memory (reads
# ~/.claude, ~/.codex, ~/.gemini), so it needs read access to the user's
# home dir but nothing else on the system, and only write access to its
# own project dir (usage.db/-wal/-shm live under PROJECT_DIR/backend) plus
# the OpenCode CLI's own state/log dir, which it insists on writing to
# every time the poller shells out to `opencode stats`, plus ~/.codex:
# state_5.sqlite is WAL-mode, and SQLite needs read-write access to its
# -shm sidecar file to open *any* connection to it, including mode=ro ones
# -- under ProtectHome=read-only that open fails with "unable to open
# database file" even though nothing is actually being written there.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=PROJECT_DIR PROJECT_HOME_DIR/.local/share/opencode PROJECT_HOME_DIR/.codex
NoNewPrivileges=yes
PrivateTmp=true

[Install]
WantedBy=multi-user.target
